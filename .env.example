# Copie para .env e ajuste. Nenhuma variavel e obrigatoria.

# Porta do servidor
PORT=3000

# Quantos agentes existem na sala (1 a 50). A sala se remonta sozinha: com mais
# agentes ela ganha colunas/fileiras e o palco cresce junto.
AGENT_COUNT=12

# Quanto tempo o balao de fala fica na tela (ms). 0 = fica ate chegar outro POST.
BUBBLE_TTL_MS=20000

# Se preenchida, POST e DELETE passam a exigir o header: x-api-key: <valor>
# A pagina (GET /api/state e /api/events) continua aberta.
API_KEY=

# Origem liberada no CORS. * libera qualquer uma.
CORS_ORIGIN=*
